# Copiar a .env. No subir .env a GitHub.
BROWSERSTACK_USER=REEMPLAZAR
BROWSERSTACK_KEY=REEMPLAZAR

# Nombre y version exactos del catalogo App Automate.
BROWSERSTACK_DEVICE=Samsung Galaxy S22 Ultra
BROWSERSTACK_OS_VERSION=12.0

# Ruta local del APK; solo se usa con npm run upload:browserstack.
APK_PATH=D:/Downloads/Clock.apk

# Opcional: si ya tienes una carga aceptada, pega aqui el identificador.
BROWSERSTACK_APP=

# Primera comprobacion: crear y cancelar alarmas.
MOBILE_TAGS=@addAlarm or @cancelAlarm
