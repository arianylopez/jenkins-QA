# Solo para ejecucion local. Jenkins utiliza la credencial con ID browserstack.
# Copia a .env si deseas ejecutar localmente. No subas .env a GitHub.
BROWSERSTACK_USER=REEMPLAZAR
BROWSERSTACK_KEY=REEMPLAZAR

# Combinacion donde se comprobo Google Clock preinstalado.
BROWSERSTACK_DEVICE=Google Pixel 7
BROWSERSTACK_OS_VERSION=13.0

# App de ejemplo aceptada: inicia la sesion. La configuracion abre Google Clock.
BROWSERSTACK_STARTER_APP=bs://95e223c5f8294026cb9b828671ce668d746f3e65
MOBILE_TAGS=@addAlarm or @cancelAlarm
