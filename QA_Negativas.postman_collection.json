{
  "info": {
    "name": "QA Negativas - GoREST",
    "description": "Pruebas negativas de seguridad, identificación de recursos y validación. Un 4xx esperado es un test aprobado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "NEG - Usuario inexistente devuelve 404",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP esperado 404 - NEG - Usuario inexistente devuelve 404\", () => {",
              "  pm.response.to.have.status(404);",
              "});",
              "if (pm.response.code === 404) pm.test('No regresa un usuario válido', () => pm.expect(pm.response.text()).not.to.be.empty);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{url}}/users/999999999999",
          "host": [
            "{{url}}"
          ],
          "path": [
            "users",
            "999999999999"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      },
      "response": []
    },
    {
      "name": "NEG - Alta sin token rechazada 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP esperado 401 - NEG - Alta sin token rechazada 401\", () => {",
              "  pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{url}}/users",
          "host": [
            "{{url}}"
          ],
          "path": [
            "users"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"QA Demo\",\n  \"email\": \"qa_sin_token@example.org\",\n  \"gender\": \"female\",\n  \"status\": \"active\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "response": []
    },
    {
      "name": "NEG - Token inválido rechazado 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP esperado 401 - NEG - Token inválido rechazado 401\", () => {",
              "  pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{url}}/users",
          "host": [
            "{{url}}"
          ],
          "path": [
            "users"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"QA Demo\",\n  \"email\": \"qa_token_invalido@example.org\",\n  \"gender\": \"female\",\n  \"status\": \"active\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "token-deliberadamente-invalido",
              "type": "string"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "NEG - Correo inválido produce 422",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP esperado 422 - NEG - Correo inválido produce 422\", () => {",
              "  pm.response.to.have.status(422);",
              "});",
              "if (pm.response.code === 422) {",
              "           pm.test('La API indica el campo inválido', () => {",
              "             const errors = pm.response.json();",
              "             pm.expect(errors).to.be.an('array');",
              "             pm.expect(errors.some(e => e.field === 'email')).to.eql(true);",
              "           });",
              "         }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{url}}/users",
          "host": [
            "{{url}}"
          ],
          "path": [
            "users"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"QA Demo\",\n  \"email\": \"correo-no-es-email\",\n  \"gender\": \"female\",\n  \"status\": \"active\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "response": []
    }
  ]
}
