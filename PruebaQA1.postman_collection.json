        {
          "name": "POSTUser",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Clear identifiers from previous runs; no stale record must be reused.",
                  "['id', 'id_post', 'id_comment', 'id_todo'].forEach(function (key) {",
                  "    pm.environment.unset(key);",
                  "});",
                  "// Make each user email unique so repeat CI builds do not collide.",
                  "const suffix = Date.now().toString(36) + '_' + Math.floor(Math.random() * 1000000).toString(36);",
                  "pm.environment.set('email', 'usuario_' + suffix + '@test.com');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Tiempo de respuesta menor al limite configurado', function () {",
                  "    const maxMs = Number(pm.environment.get('maxResponseTimeMs') || 3000);",
                  "    pm.expect(pm.response.responseTime).to.be.below(maxMs);",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    pm.test('Nombre del Usuario', function () {",
                  "        pm.expect(data.name).to.eql('Ariany Lopez Melgar');",
                  "        pm.expect(data.id).to.be.a('number').and.greaterThan(0);",
                  "    });",
                  "    pm.environment.set('name', data.name);",
                  "    pm.environment.set('id', String(data.id));",
                  "    pm.environment.set('gender', data.gender);",
                  "    pm.environment.set('status', data.status);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
